{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotobookGen",
  "version": "0.2.1",
  "identifier": "com.jiajingteoh.photobook",
  "build": {
    "beforeDevCommand": "bun run sidecar && bun run ui:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run sidecar && bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "PhotobookGen",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "15.0" },
    "externalBin": ["binaries/photobook-engine"],
    "resources": { "../templates": "templates" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Ripwords/photobook-generator/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMERFRDI2QTYyNUNCNgpSV1MyWEdKcTB0NndCbnNQc1VDaS80cW9PVklpT3dsYjJsZ0NNa0hkQkFHVjA5M0dIa0UzL3dtMAo="
    }
  }
}
